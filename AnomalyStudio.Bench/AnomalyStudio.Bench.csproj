  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AnomalyStudio.Bench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnomalyStudio.Core\AnomalyStudio.Core.csproj" />
  </ItemGroup>
</Project>
