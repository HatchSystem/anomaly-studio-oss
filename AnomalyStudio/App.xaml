<Application x:Class="AnomalyStudio.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- AnomalyStudio Fluent 2 デザイントークン -->
        <ResourceDictionary Source="ms-appx:///Styles/Colors.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
