<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="using:AnomalyStudio.Helpers">
  <helpers:BoolToVisibilityConverter x:Key="AsBoolToVisibility" />
  <helpers:BoolToVisibilityConverter x:Key="AsInverseBoolToVisibility" Invert="True" />
  <helpers:InverseBoolConverter x:Key="AsInverseBoolConverter" />

  <!-- 角丸: 4（コントロール）/ 8（カード・レイヤー） -->
  <CornerRadius x:Key="AsControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="AsCardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

  <Thickness x:Key="AsPagePadding">20,20,20,16</Thickness>
  <Thickness x:Key="AsSettingsPagePadding">28,24,28,24</Thickness>
  <x:Double x:Key="AsGridRowHeight">32</x:Double>
  <!-- 設定系ページの本文幅。ウィンドウに合わせて伸び、広い画面では読みやすさのためこの幅で止める -->
  <x:Double x:Key="AsSettingsMaxWidth">1200</x:Double>

  <!-- カード -->
  <Style x:Key="AsCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource AsCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource AsStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource AsCardCornerRadius}" />
  </Style>

  <!-- WinUI SettingsCard 相当（アイコン / タイトル / 説明 / コントロール） -->
  <Style x:Key="AsSettingsCardStyle" TargetType="Border" BasedOn="{StaticResource AsCardStyle}">
    <Setter Property="CornerRadius" Value="{StaticResource AsControlCornerRadius}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- LONG / SHORT などのピル -->
  <Style x:Key="AsPillStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style x:Key="AsLongPillStyle" TargetType="Border" BasedOn="{StaticResource AsPillStyle}">
    <Setter Property="Background" Value="{ThemeResource AsPositiveBackgroundBrush}" />
  </Style>
  <Style x:Key="AsShortPillStyle" TargetType="Border" BasedOn="{StaticResource AsPillStyle}">
    <Setter Property="Background" Value="{ThemeResource AsNegativeBackgroundBrush}" />
  </Style>
  <Style x:Key="AsPillTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="40" />
  </Style>

  <!-- 国コード（JP / US …）の枠付きバッジ -->
  <Style x:Key="AsCodeBadgeStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource AsStrokeStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Height" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- データグリッド（ListView ベース） -->
  <Style x:Key="AsGridItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style x:Key="AsGridListViewStyle" TargetType="ListView">
    <Setter Property="SelectionMode" Value="None" />
    <Setter Property="IsItemClickEnabled" Value="False" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource AsGridItemContainerStyle}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- ツールバーなどの透明ボタン -->
  <Style x:Key="AsSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource AsTextPrimaryBrush}" />
  </Style>

  <!-- データグリッドの行全体をボタンにする（展開できる行） -->
  <Style x:Key="AsGridRowButtonStyle" TargetType="Button" BasedOn="{StaticResource AsSubtleButtonStyle}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <!-- データグリッドの並べ替えできる列見出し（列の幅いっぱいを押せる） -->
  <Style x:Key="AsGridHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource AsSubtleButtonStyle}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="AsIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AsSubtleButtonStyle}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource AsIconFontFamily}" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <!-- 等幅マルチライン（SQL エディター） -->
  <Style x:Key="AsCodeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="FontFamily" Value="{StaticResource AsMonoFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="IsSpellCheckEnabled" Value="False" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
  </Style>

  <Style x:Key="AsProgressTrackStyle" TargetType="ProgressBar">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{ThemeResource AsTrackBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource AsAccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
