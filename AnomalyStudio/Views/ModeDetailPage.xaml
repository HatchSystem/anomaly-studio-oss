<Page x:Class="AnomalyStudio.Views.ModeDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
  <!-- 7a/7b モード詳細: モード名・説明・抽出SQL（残りの高さいっぱいの等幅エディター）・削除／既定に戻す・保存／キャンセル -->
  <Grid Padding="{StaticResource AsSettingsPagePadding}" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <HyperlinkButton Content="データ抽出設定" Padding="0" FontSize="20" FontWeight="SemiBold"
                         Foreground="{ThemeResource AsTextSecondaryBrush}" Command="{x:Bind ViewModel.CancelCommand}" />
        <TextBlock Text="{StaticResource IconCaretRight}" Style="{StaticResource AsIconStyle}" />
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource AsTitleTextStyle}" />
      </StackPanel>
      <Button HorizontalAlignment="Right" Click="OnAiAssistClick" Padding="14,6"
              IsEnabled="{x:Bind ViewModel.CanUseAiAssist, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.AiAssistHint, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{StaticResource IconSparkle}" FontFamily="{StaticResource AsIconFillFontFamily}"
                     Foreground="{ThemeResource AsAccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="AIアシスト" />
        </StackPanel>
      </Button>
    </Grid>

    <TextBlock Grid.Row="1" Text="モード名" Style="{StaticResource AsBodyStrongTextStyle}" FontWeight="Normal" />
    <TextBox Grid.Row="2" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" Margin="0,0,0,8" />

    <TextBlock Grid.Row="3" Text="モード説明" Style="{StaticResource AsBodyStrongTextStyle}" FontWeight="Normal" />
    <TextBox Grid.Row="4" Text="{x:Bind ViewModel.Description, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
             Height="56" Margin="0,0,0,8" />

    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="抽出SQL" Style="{StaticResource AsBodyStrongTextStyle}" FontWeight="Normal" />
      <TextBlock Text="{x:Bind ViewModel.SqlLines, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}" />
      <TextBlock Style="{StaticResource AsCaptionTextStyle}"
                 Text="candidate_stats から direction / entry_min / hold_min / score を優先順に返す SELECT 文（$run_id は最新の分析結果）" />
      <TextBlock Text="{StaticResource IconInfo}" Style="{StaticResource AsIconStyle}" FontSize="14">
        <ToolTipService.ToolTip>
          <ToolTip MaxWidth="640">
            <TextBlock Text="{x:Bind ViewModel.SchemaHint}" FontFamily="{StaticResource AsMonoFontFamily}" FontSize="11" TextWrapping="Wrap" />
          </ToolTip>
        </ToolTipService.ToolTip>
      </TextBlock>
    </StackPanel>
    <TextBox Grid.Row="6" Style="{StaticResource AsCodeTextBoxStyle}" Text="{x:Bind ViewModel.Sql, Mode=TwoWay}"
             VerticalAlignment="Stretch" />

    <Grid Grid.Row="7" Margin="0,8,0,0" ColumnSpacing="8" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- 既定モードの SQL を既定から変えているときの注意 -->
      <TextBlock Grid.ColumnSpan="5" Text="{x:Bind ViewModel.DefaultSqlNotice, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}"
                 Foreground="{ThemeResource AsTextSecondaryBrush}" TextWrapping="Wrap" TextTrimming="None"
                 Visibility="{x:Bind ViewModel.HasDefaultSqlNotice, Mode=OneWay}" />
      <!-- 自作のモードは削除できる。既定モードは削除できず、既定に戻せる -->
      <Button Grid.Row="1" Content="削除" MinWidth="96" Click="OnDeleteClick"
              Visibility="{x:Bind ViewModel.CanDelete, Mode=OneWay}" />
      <Button Grid.Row="1" Grid.Column="1" Content="既定に戻す" MinWidth="96" Command="{x:Bind ViewModel.ResetToDefaultCommand}"
              Visibility="{x:Bind ViewModel.IsDefault, Mode=OneWay}"
              ToolTipService.ToolTip="名前・説明・SQL を既定に戻します（保存すると反映）" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}"
                 Foreground="{ThemeResource AsNegativeBrush}" TextWrapping="Wrap" MaxLines="3" />
      <Button Grid.Row="1" Grid.Column="3" Content="キャンセル" MinWidth="96" Command="{x:Bind ViewModel.CancelCommand}" />
      <Button Grid.Row="1" Grid.Column="4" Content="保存" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
    </Grid>
  </Grid>
</Page>
