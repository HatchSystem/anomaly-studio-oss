<Page x:Class="AnomalyStudio.Views.OptimizationCheckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="using:AnomalyStudio.Helpers"
      xmlns:vm="using:AnomalyStudio.ViewModels"
      Background="Transparent">
  <!-- 最適化確認: 最新の分析結果のポイントを検証期間の各日に当てはめる（評価サイクルは集計単位のみ）。
       レイアウトは BacktestPage と共通で、期間の行をクリックするとポイントごとの成績を展開する -->
  <Page.Resources>
    <!-- 列幅（ヘッダーと行で共有）: 期間・取引数・勝ち・負け・勝率・平均pips・合計pips。
         最小幅で内容が収まり、余った幅は比率で配分する（書式は Helpers/GridColumns.cs） -->
    <x:String x:Key="GridLayout">2*:250, 1*:72, 1*:64, 1*:64, 1.5*:130, 1*:84, 1*:96</x:String>
    <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AsSecondaryTextStyle}">
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Page.Resources>

  <Grid Padding="{StaticResource AsPagePadding}" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="最適化確認" Style="{StaticResource AsTitleTextStyle}" />
      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}"
                 TextWrapping="Wrap" MaxLines="2" />
      <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RangeLabel, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}" />
    </Grid>

    <!-- モード・評価サイクル・実行 -->
    <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="銘柄" Style="{StaticResource LabelStyle}" />
      <!-- 1 つなら銘柄ごと、複数なら選んだ銘柄をまとめた複合ポイントで評価する -->
      <DropDownButton Grid.Column="1" MinWidth="140" ToolTipService.ToolTip="{x:Bind ViewModel.SymbolListLabel, Mode=OneWay}">
        <TextBlock Text="{x:Bind ViewModel.SymbolLabel, Mode=OneWay}" FontWeight="SemiBold" />
        <DropDownButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <StackPanel Width="220" Spacing="2">
              <Button Content="すべて選択 / 解除" Style="{StaticResource AsSubtleButtonStyle}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.SelectAllSymbolsCommand}" />
              <Rectangle Height="1" Fill="{ThemeResource AsDividerBrush}" Margin="0,2" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.SymbolOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SymbolOptionViewModel">
                    <CheckBox Content="{x:Bind Id}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinHeight="32" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="複数選ぶと、選んだ銘柄をまとめた順位（複合ポイント）で評価します" TextWrapping="Wrap"
                         Style="{StaticResource AsCaptionTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <TextBlock Grid.Column="2" Text="モード" Style="{StaticResource LabelStyle}" Margin="8,0,0,0" />
      <ComboBox Grid.Column="3" Width="170" ItemsSource="{x:Bind ViewModel.Modes}"
                SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" />
      <TextBlock Grid.Column="4" Text="評価サイクル" Style="{StaticResource LabelStyle}" Margin="8,0,0,0" />
      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
        <RadioButton GroupName="Cycle" Content="毎日" MinWidth="72" FontWeight="SemiBold" IsChecked="{x:Bind ViewModel.IsDaily, Mode=TwoWay}" />
        <RadioButton GroupName="Cycle" Content="毎週" MinWidth="72" FontWeight="SemiBold" IsChecked="{x:Bind ViewModel.IsWeekly, Mode=TwoWay}" />
        <RadioButton GroupName="Cycle" Content="毎月" MinWidth="72" FontWeight="SemiBold" IsChecked="{x:Bind ViewModel.IsMonthly, Mode=TwoWay}" />
      </StackPanel>
      <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="8">
        <!-- 銘柄・モード・評価サイクル・検証期間をバックテスト画面へ写して移動する（確認してから） -->
        <Button Content="バックテストへコピー" Click="OnCopyToBacktestClick"
                ToolTipService.ToolTip="この画面の条件（銘柄・モード・評価サイクル・検証期間）をウォークフォワード・バックテストの画面に設定して移動します" />
        <Button Style="{StaticResource AccentButtonStyle}" Padding="18,6" Command="{x:Bind ViewModel.RunCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{StaticResource IconPlay}" FontFamily="{StaticResource AsIconFillFontFamily}" VerticalAlignment="Center" />
            <TextBlock Text="実行" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- 検証期間・取引時間帯（境界を跨がないポイント）・ポイント数（順位の高い順）。絞り込みは計算済みの結果に当てはめ、設定に保存する -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
      <TextBlock Text="検証期間" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
      <CalendarDatePicker Width="140" DateFormat="{}{year.full}/{month.integer(2)}/{day.integer(2)}"
                          Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" />
      <TextBlock Text="〜" Style="{StaticResource AsSecondaryTextStyle}" />
      <CalendarDatePicker Width="140" DateFormat="{}{year.full}/{month.integer(2)}/{day.integer(2)}"
                          Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" />
      <TextBlock Text="取引時間帯" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
      <ComboBox MinWidth="92" ItemsSource="{x:Bind ViewModel.StartHourOptions}"
                SelectedItem="{x:Bind ViewModel.StartHourLabel, Mode=TwoWay}" />
      <TextBlock Text="〜" Style="{StaticResource AsSecondaryTextStyle}" />
      <ComboBox MinWidth="92" ItemsSource="{x:Bind ViewModel.EndHourOptions}"
                SelectedItem="{x:Bind ViewModel.EndHourLabel, Mode=TwoWay}" />
      <TextBlock Text="ポイント数" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
      <ComboBox MinWidth="104" ItemsSource="{x:Bind ViewModel.PointCountOptions}"
                SelectedItem="{x:Bind ViewModel.PointCountLabel, Mode=TwoWay}"
                ToolTipService.ToolTip="時間帯に収まるポイントのうち、順位（スコア）の高い順に使う数" />
    </StackPanel>

    <!-- 曜日（取引日）と、グリッドの右上に保存ボタン -->
    <Grid Grid.Row="3" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="曜日" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
        <Button Content="すべて選択" Command="{x:Bind ViewModel.SelectAllWeekdaysCommand}" ToolTipService.ToolTip="すべて選択 / 解除" />
      </StackPanel>
      <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Weekdays}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WeekdayOptionViewModel">
            <ToggleButton Content="{x:Bind Label}" MinWidth="40" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Grid.Column="3" Command="{x:Bind ViewModel.SaveCsvCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{StaticResource IconFileCsv}" FontFamily="{StaticResource AsIconFontFamily}" VerticalAlignment="Center" />
          <TextBlock Text="CSV保存" FontWeight="SemiBold" />
        </StackPanel>
      </Button>
      <Button Grid.Column="4" Command="{x:Bind ViewModel.SaveReportCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{StaticResource IconFileText}" FontFamily="{StaticResource AsIconFontFamily}" VerticalAlignment="Center" />
          <TextBlock Text="レポート保存" FontWeight="SemiBold" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- データグリッド + 合計行 -->
    <Border Grid.Row="4" Style="{StaticResource AsCardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="34" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="38" />
        </Grid.RowDefinitions>
        <Grid Padding="12,0" BorderBrush="{ThemeResource AsDividerBrush}" BorderThickness="0,0,0,1" helpers:GridColumns.Layout="{StaticResource GridLayout}">
          <TextBlock Text="{x:Bind ViewModel.PeriodHeader, Mode=OneWay}" Style="{StaticResource AsGridHeaderTextStyle}" />
          <TextBlock Grid.Column="1" Text="取引数" Style="{StaticResource AsGridHeaderTextStyle}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="2" Text="勝ち" Style="{StaticResource AsGridHeaderTextStyle}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Text="負け" Style="{StaticResource AsGridHeaderTextStyle}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="4" Text="勝率" Style="{StaticResource AsGridHeaderTextStyle}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="5" Style="{StaticResource AsGridHeaderTextStyle}" HorizontalAlignment="Right"><Run Text="平均" /><Run Text="{x:Bind ViewModel.UnitLabel, Mode=OneWay}" /></TextBlock>
          <TextBlock Grid.Column="6" Style="{StaticResource AsGridHeaderTextStyle}" HorizontalAlignment="Right"><Run Text="合計" /><Run Text="{x:Bind ViewModel.UnitLabel, Mode=OneWay}" /></TextBlock>
        </Grid>

        <ListView Grid.Row="1" Style="{StaticResource AsGridListViewStyle}" ItemsSource="{x:Bind ViewModel.Rows}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:BacktestRowViewModel">
              <StackPanel>
                <!-- 期間の行（クリックで展開） -->
                <Grid Height="32">
                  <Border Background="{ThemeResource AsZebraBrush}" Visibility="{x:Bind IsOdd}" />
                  <Button Style="{StaticResource AsGridRowButtonStyle}" Command="{x:Bind ToggleCommand}"
                          ToolTipService.ToolTip="ポイントごとの成績を表示">
                    <Grid Padding="12,0" helpers:GridColumns.Layout="{StaticResource GridLayout}">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource IconCaretRight}" Style="{StaticResource AsIconStyle}" FontSize="12"
                                   Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource AsInverseBoolToVisibility}}" />
                        <TextBlock Text="{StaticResource IconCaretDown}" Style="{StaticResource AsIconStyle}" FontSize="12"
                                   Visibility="{x:Bind IsExpanded, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource AsBodyTextStyle}" FontSize="13" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{x:Bind Trades}" Style="{StaticResource AsNumberTextStyle}" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{x:Bind Wins}" Style="{StaticResource AsNumberTextStyle}" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{x:Bind Losses}" Style="{StaticResource AsNumberTextStyle}" FontSize="13" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                        <ProgressBar Style="{StaticResource AsProgressTrackStyle}" Width="40" Value="{x:Bind WinRatePercent}" />
                        <TextBlock Text="{x:Bind WinRate}" Style="{StaticResource AsNumberTextStyle}" FontSize="13" Width="46" />
                      </StackPanel>
                      <TextBlock Grid.Column="5" Text="{x:Bind AveragePips}" Style="{StaticResource AsNumberTextStyle}" FontSize="13" VerticalAlignment="Center"
                                 Foreground="{ThemeResource AsPositiveBrush}" Visibility="{x:Bind AveragePositive}" />
                      <TextBlock Grid.Column="5" Text="{x:Bind AveragePips}" Style="{StaticResource AsNumberTextStyle}" FontSize="13" VerticalAlignment="Center"
                                 Foreground="{ThemeResource AsNegativeBrush}" Visibility="{x:Bind AverageNegative}" />
                      <TextBlock Grid.Column="6" Text="{x:Bind TotalPips}" Style="{StaticResource AsNumberTextStyle}" FontSize="13" VerticalAlignment="Center"
                                 Foreground="{ThemeResource AsPositiveBrush}" Visibility="{x:Bind TotalPositive}" />
                      <TextBlock Grid.Column="6" Text="{x:Bind TotalPips}" Style="{StaticResource AsNumberTextStyle}" FontSize="13" VerticalAlignment="Center"
                                 Foreground="{ThemeResource AsNegativeBrush}" Visibility="{x:Bind TotalNegative}" />
                    </Grid>
                  </Button>
                </Grid>

                <!-- 展開: 期間内のポイントごとの成績（Entry 時刻順） -->
                <ItemsControl ItemsSource="{x:Bind Points, Mode=OneWay}" Visibility="{x:Bind IsExpanded, Mode=OneWay}"
                              Background="{ThemeResource AsSubtleFillBrush}" BorderBrush="{ThemeResource AsDividerBrush}" BorderThickness="0,1">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BacktestPointRowViewModel">
                      <Grid Height="28" Padding="12,0" helpers:GridColumns.Layout="{StaticResource GridLayout}">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{x:Bind Rank}" Style="{StaticResource AsSecondaryTextStyle}" FontSize="12" Width="30" />
                          <TextBlock Text="{x:Bind Direction}" Style="{StaticResource AsBodyStrongTextStyle}" FontSize="12" Width="40"
                                     Foreground="{ThemeResource AsAccentBrush}" Visibility="{x:Bind IsLong}" />
                          <TextBlock Text="{x:Bind Direction}" Style="{StaticResource AsBodyStrongTextStyle}" FontSize="12" Width="40"
                                     Visibility="{x:Bind IsShort}" />
                          <TextBlock Text="{x:Bind Time}" Style="{StaticResource AsBodyTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Trades}" Style="{StaticResource AsNumberTextStyle}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Wins}" Style="{StaticResource AsNumberTextStyle}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Losses}" Style="{StaticResource AsNumberTextStyle}" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                          <ProgressBar Style="{StaticResource AsProgressTrackStyle}" Width="40" Value="{x:Bind WinRatePercent}" />
                          <TextBlock Text="{x:Bind WinRate}" Style="{StaticResource AsNumberTextStyle}" FontSize="12" Width="46" />
                        </StackPanel>
                        <TextBlock Grid.Column="5" Text="{x:Bind AveragePips}" Style="{StaticResource AsNumberTextStyle}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource AsPositiveBrush}" Visibility="{x:Bind AveragePositive}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind AveragePips}" Style="{StaticResource AsNumberTextStyle}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource AsNegativeBrush}" Visibility="{x:Bind AverageNegative}" />
                        <TextBlock Grid.Column="6" Text="{x:Bind TotalPips}" Style="{StaticResource AsNumberTextStyle}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource AsPositiveBrush}" Visibility="{x:Bind TotalPositive}" />
                        <TextBlock Grid.Column="6" Text="{x:Bind TotalPips}" Style="{StaticResource AsNumberTextStyle}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource AsNegativeBrush}" Visibility="{x:Bind TotalNegative}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <!-- 安定性の指標（t 値・信頼区間・PF・最大DD・最大連敗）と、無作為に選んだ場合との比較（ランダム基準）。取引がなければ空 -->
        <StackPanel Grid.Row="2" Padding="12,6" Spacing="2" BorderBrush="{ThemeResource AsDividerBrush}" BorderThickness="0,1,0,0"
                    Visibility="{x:Bind ViewModel.HasStats, Mode=OneWay}">
          <TextBlock Text="{x:Bind ViewModel.StatsLabel, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind ViewModel.BaselineLabel, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 合計行 -->
        <Grid Grid.Row="3" Padding="12,0" Background="{ThemeResource AsFooterBrush}" CornerRadius="0,0,8,8"
              BorderBrush="{ThemeResource AsDividerBrush}" BorderThickness="0,1,0,0" helpers:GridColumns.Layout="{StaticResource GridLayout}">
          <TextBlock Text="合計" Style="{StaticResource AsBodyStrongTextStyle}" FontSize="13" />
          <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SumTrades, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SumWins, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.SumLosses, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.SumWinRate, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.SumAverage, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Grid.Column="6" Text="{x:Bind ViewModel.SumTotal, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13"
                     Foreground="{ThemeResource AsPositiveBrush}" Visibility="{x:Bind ViewModel.SumTotalPositive, Mode=OneWay}" />
          <TextBlock Grid.Column="6" Text="{x:Bind ViewModel.SumTotal, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13"
                     Foreground="{ThemeResource AsNegativeBrush}"
                     Visibility="{x:Bind ViewModel.SumTotalPositive, Mode=OneWay, Converter={StaticResource AsInverseBoolToVisibility}}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
