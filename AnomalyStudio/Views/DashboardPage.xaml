<Page x:Class="AnomalyStudio.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
  <!-- 1c/3b ダッシュボード: ロゴ・日付・夏時間表示・時計・次のエントリー・次の経済指標（中央にまとめ、上下の余白をそろえる） -->
  <Page.Resources>
    <Style x:Key="CardRowStyle" TargetType="Border" BasedOn="{StaticResource AsCardStyle}">
      <Setter Property="Height" Value="50" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
  </Page.Resources>

  <Grid>
    <StackPanel Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24">
      <!-- ロゴ -->
      <Image Source="ms-appx:///Assets/Images/anomalystudio-logo.png" Width="180" Height="180" Stretch="Uniform"
             HorizontalAlignment="Center" Margin="0,0,0,28" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
        <TextBlock Text="{x:Bind ViewModel.DateText, Mode=OneWay}" Style="{StaticResource AsSecondaryTextStyle}" />
        <Border CornerRadius="10" Padding="8,2" BorderThickness="1" BorderBrush="{ThemeResource AsStrokeStrongBrush}"
                ToolTipService.ToolTip="{x:Bind ViewModel.DstDescription, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Style="{StaticResource AsIconStyle}" FontSize="12" Text="{StaticResource IconSun}"
                       Visibility="{x:Bind ViewModel.IsDst, Mode=OneWay}" />
            <TextBlock Style="{StaticResource AsIconStyle}" FontSize="12" Text="{StaticResource IconSnowflake}"
                       Visibility="{x:Bind ViewModel.IsDst, Mode=OneWay, Converter={StaticResource AsInverseBoolToVisibility}}" />
            <TextBlock Text="{x:Bind ViewModel.DstLabel, Mode=OneWay}" FontSize="11"
                       Foreground="{ThemeResource AsTextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 数字の上下にある行間の分だけ詰め、日付との間・カードとの間を見た目でそろえる -->
      <TextBlock Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,-4,0,24"
                 FontFamily="{StaticResource AsClockFontFamily}" FontSize="104" FontWeight="SemiBold"
                 Foreground="{ThemeResource AsTextPrimaryBrush}" />

      <StackPanel Spacing="8">
      <!-- 次のエントリー -->
      <Border Style="{StaticResource CardRowStyle}">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource AsIconButtonStyle}" Content="{StaticResource IconCaretLeft}"
                  Command="{x:Bind ViewModel.PreviousEntryCommand}" ToolTipService.ToolTip="前のエントリー" />
          <TextBlock Grid.Column="1" Style="{StaticResource AsIconStyle}" FontSize="18"
                     Foreground="{ThemeResource AsAccentBrush}" Text="{StaticResource IconCrosshair}" />
          <Button Grid.Column="2" Style="{StaticResource AsSubtleButtonStyle}" Padding="4,2" Command="{x:Bind ViewModel.ToggleCompositeCommand}"
                  ToolTipService.ToolTip="銘柄別／複合ポイント（全銘柄をまとめた順位）を切り替え">
            <TextBlock Text="{x:Bind ViewModel.EntryKindLabel, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}" FontSize="13" />
          </Button>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="14">
            <TextBlock Text="{x:Bind ViewModel.EntryPair, Mode=OneWay}" Style="{StaticResource AsBodyStrongTextStyle}" FontSize="15" />
            <TextBlock Text="{x:Bind ViewModel.EntrySlot, Mode=OneWay}" Style="{StaticResource AsBodyTextStyle}" />
            <Border Style="{StaticResource AsLongPillStyle}" Visibility="{x:Bind ViewModel.EntryIsLong, Mode=OneWay}">
              <TextBlock Text="LONG" Style="{StaticResource AsPillTextStyle}" Foreground="{ThemeResource AsPositiveBrush}" />
            </Border>
            <Border Style="{StaticResource AsShortPillStyle}" Visibility="{x:Bind ViewModel.EntryIsShort, Mode=OneWay}">
              <TextBlock Text="SHORT" Style="{StaticResource AsPillTextStyle}" Foreground="{ThemeResource AsNegativeBrush}" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.EntryHasResult, Mode=OneWay}">
              <TextBlock Text="結果" Style="{StaticResource AsCaptionTextStyle}" />
              <TextBlock Text="{x:Bind ViewModel.EntryResult, Mode=OneWay}" Style="{StaticResource AsBodyStrongTextStyle}"
                         Foreground="{ThemeResource AsPositiveBrush}" Visibility="{x:Bind ViewModel.EntryResultPositive, Mode=OneWay}" />
              <TextBlock Text="{x:Bind ViewModel.EntryResult, Mode=OneWay}" Style="{StaticResource AsBodyStrongTextStyle}"
                         Foreground="{ThemeResource AsNegativeBrush}" Visibility="{x:Bind ViewModel.EntryResultNegative, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.EntryPosition, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}" FontSize="11" />
          </StackPanel>
          <Button Grid.Column="4" Style="{StaticResource AsIconButtonStyle}" Content="{StaticResource IconCaretRight}"
                  Command="{x:Bind ViewModel.NextEntryCommand}" ToolTipService.ToolTip="次のエントリー" />
        </Grid>
      </Border>

      <!-- 次の経済指標 -->
      <Border Style="{StaticResource CardRowStyle}">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource AsIconButtonStyle}" Content="{StaticResource IconCaretLeft}"
                  Command="{x:Bind ViewModel.PreviousEventCommand}" ToolTipService.ToolTip="前の指標" />
          <TextBlock Grid.Column="1" Style="{StaticResource AsIconStyle}" FontSize="18"
                     Foreground="{ThemeResource AsAccentBrush}" Text="{StaticResource IconCalendarDots}" />
          <TextBlock Grid.Column="2" Text="経済指標" Style="{StaticResource AsCaptionTextStyle}" FontSize="13" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{x:Bind ViewModel.EventClock, Mode=OneWay}" Style="{StaticResource AsBodyStrongTextStyle}" />
            <Border Style="{StaticResource AsCodeBadgeStyle}">
              <TextBlock Text="{x:Bind ViewModel.EventCountry, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{ThemeResource AsTextPrimaryBrush}" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{x:Bind ViewModel.EventName, Mode=OneWay}" Style="{StaticResource AsBodyStrongTextStyle}"
                       FontSize="15" MaxWidth="200" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind ViewModel.EventStarsOn, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AsAccentBrush}" />
              <TextBlock Text="{x:Bind ViewModel.EventStarsOff, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AsStarOffBrush}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.EventTiming, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <Button Grid.Column="4" Style="{StaticResource AsIconButtonStyle}" Content="{StaticResource IconCaretRight}"
                  Command="{x:Bind ViewModel.NextEventCommand}" ToolTipService.ToolTip="次の指標" />
        </Grid>
      </Border>
      </StackPanel>
    </StackPanel>
  </Grid>
</Page>
