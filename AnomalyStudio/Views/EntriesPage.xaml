<Page x:Class="AnomalyStudio.Views.EntriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="using:AnomalyStudio.Helpers"
      xmlns:vm="using:AnomalyStudio.ViewModels"
      NavigationCacheMode="Required"
      Background="Transparent">
  <!-- 2c/3a エントリー一覧: 1 日単位（既定は今日、前後の日へ移動）でエントリーを時刻順に。次の行を左インジケーター付きでハイライト -->
  <Page.Resources>
    <!-- 列幅（ヘッダーと行で共有）: 状態・順位・銘柄・時間帯・方向・モード・平均勝率・平均pips・結果pips・操作。
         最小幅で内容が収まり、余った幅は比率で配分する（書式は Helpers/GridColumns.cs） -->
    <x:String x:Key="GridLayout">76, 56, 1*:76, 2*:150, 72, 1.5*:110, 1.5*:130, 1*:96, 1*:96</x:String>

    <!-- 並べ替えできる列見出し: 列名と、並べ替えに使っている列だけ向きの矢印 -->
    <DataTemplate x:Key="SortHeaderTemplate" x:DataType="vm:EntrySortHeaderViewModel">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="{x:Bind Label}" Style="{StaticResource AsGridHeaderTextStyle}" />
        <TextBlock Text="{StaticResource IconCaretUp}" Style="{StaticResource AsIconStyle}" FontSize="11" VerticalAlignment="Center"
                   Visibility="{x:Bind IsAscending, Mode=OneWay}" />
        <TextBlock Text="{StaticResource IconCaretDown}" Style="{StaticResource AsIconStyle}" FontSize="11" VerticalAlignment="Center"
                   Visibility="{x:Bind IsDescending, Mode=OneWay}" />
      </StackPanel>
    </DataTemplate>

    <Style x:Key="FilterButtonStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="{ThemeResource AsCardBrush}" />
    </Style>
  </Page.Resources>

  <Grid Padding="{StaticResource AsPagePadding}" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- タイトル・次のエントリー・時計 -->
    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="エントリー" Style="{StaticResource AsTitleTextStyle}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border CornerRadius="10" Padding="7,1" Background="{ThemeResource AsSubtleFillHoverBrush}">
          <TextBlock Text="{x:Bind ViewModel.Count, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{ThemeResource AsTextSecondaryBrush}" />
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
        <TextBlock Style="{StaticResource AsCaptionTextStyle}">
          <Run Text="次:" /> <Run Text="{x:Bind ViewModel.NextPair, Mode=OneWay}" />
          <Run Text="{x:Bind ViewModel.NextPrefix, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{x:Bind ViewModel.NextCountdown, Mode=OneWay}" FontSize="12" FontWeight="Bold"
                   Foreground="{ThemeResource AsTextPrimaryBrush}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" Margin="8,0,0,0"
                 FontFamily="{StaticResource AsClockFontFamily}" FontSize="20" FontWeight="SemiBold"
                 Foreground="{ThemeResource AsTextPrimaryBrush}" />
    </Grid>

    <!-- 表示する日（既定は今日、記憶しない）と絞り込み -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button Width="34" Height="32" Padding="0" FontFamily="{StaticResource AsIconFontFamily}"
              Content="{StaticResource IconCaretLeft}" Command="{x:Bind ViewModel.PreviousDayCommand}" ToolTipService.ToolTip="前の日" />
      <Button Height="32" Content="今日" Command="{x:Bind ViewModel.TodayCommand}" />
      <Button Width="34" Height="32" Padding="0" FontFamily="{StaticResource AsIconFontFamily}"
              Content="{StaticResource IconCaretRight}" Command="{x:Bind ViewModel.NextDayCommand}" ToolTipService.ToolTip="次の日" />
      <TextBlock Text="{x:Bind ViewModel.DateLabel, Mode=OneWay}" Margin="6,0,0,0" MinWidth="150"
                 Style="{StaticResource AsBodyStrongTextStyle}" FontSize="13" />
      <Border CornerRadius="4" Padding="6,0" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"
              Background="{ThemeResource AsAccentBrush}" Visibility="{x:Bind ViewModel.IsToday, Mode=OneWay}">
        <TextBlock Text="今日" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{ThemeResource AsTextOnAccentBrush}" />
      </Border>
      <!-- 銘柄（複数選択）。複合モードでは選んだ銘柄をまとめて順位付けする -->
      <DropDownButton Background="{ThemeResource AsCardBrush}" ToolTipService.ToolTip="{x:Bind ViewModel.SymbolListLabel, Mode=OneWay}">
        <TextBlock><Run Text="銘柄" Foreground="{ThemeResource AsTextSecondaryBrush}" />  <Run Text="{x:Bind ViewModel.SymbolLabel, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
        <DropDownButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <StackPanel Width="220" Spacing="2">
              <Button Content="すべて選択 / 解除" Style="{StaticResource AsSubtleButtonStyle}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.SelectAllSymbolsCommand}" />
              <Rectangle Height="1" Fill="{ThemeResource AsDividerBrush}" Margin="0,2" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.SymbolOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SymbolOptionViewModel">
                    <CheckBox Content="{x:Bind Id}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinHeight="32" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <ToggleButton Content="複合モード" IsChecked="{x:Bind ViewModel.IsComposite, Mode=TwoWay}"
                    ToolTipService.ToolTip="選んだ銘柄をまとめた順位（複合ポイント）で、最適化確認と同じ選び方（取引時間帯に収まるものを順位の高い順にポイント数まで）で抽出します" />
      <ComboBox Style="{StaticResource FilterButtonStyle}"
                ItemsSource="{x:Bind ViewModel.SideOptions}" SelectedItem="{x:Bind ViewModel.SelectedSide, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock><Run Text="方向" Foreground="{ThemeResource AsTextSecondaryBrush}" />  <Run Text="{x:Bind}" FontWeight="SemiBold" /></TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Style="{StaticResource FilterButtonStyle}"
                ItemsSource="{x:Bind ViewModel.ModeOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock><Run Text="モード" Foreground="{ThemeResource AsTextSecondaryBrush}" />  <Run Text="{x:Bind}" FontWeight="SemiBold" /></TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Style="{StaticResource FilterButtonStyle}" ToolTipService.ToolTip="銘柄 × モードごとに、取引時間帯に収まるポイントを順位（スコア）の高い順に使う数"
                Visibility="{x:Bind ViewModel.IsNotComposite, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.RankOptions}" SelectedItem="{x:Bind ViewModel.SelectedRank, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock><Run Text="順位" Foreground="{ThemeResource AsTextSecondaryBrush}" />  <Run Text="{x:Bind}" FontWeight="SemiBold" /></TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <!-- 取引時間帯（Entry から Close まで収まるポイント）・曜日（取引日）・ポイント数（複合モード）。
         最適化確認・バックテストの画面と共通の値（設定に保存） -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="取引時間帯" Style="{StaticResource AsSecondaryTextStyle}" FontSize="13" VerticalAlignment="Center"
                 ToolTipService.ToolTip="取引時間帯・曜日・ポイント数は、最適化確認・バックテストの画面と共通です" />
      <ComboBox Style="{StaticResource FilterButtonStyle}" MinWidth="92" ItemsSource="{x:Bind ViewModel.StartHourOptions}"
                SelectedItem="{x:Bind ViewModel.StartHourLabel, Mode=TwoWay}" />
      <TextBlock Text="〜" Style="{StaticResource AsSecondaryTextStyle}" VerticalAlignment="Center" />
      <ComboBox Style="{StaticResource FilterButtonStyle}" MinWidth="92" ItemsSource="{x:Bind ViewModel.EndHourOptions}"
                SelectedItem="{x:Bind ViewModel.EndHourLabel, Mode=TwoWay}" />
      <TextBlock Text="曜日" Style="{StaticResource AsSecondaryTextStyle}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" />
      <Button Content="すべて選択" Command="{x:Bind ViewModel.SelectAllWeekdaysCommand}" ToolTipService.ToolTip="すべて選択 / 解除" />
      <ItemsControl ItemsSource="{x:Bind ViewModel.Weekdays}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WeekdayOptionViewModel">
            <ToggleButton Content="{x:Bind Label}" MinWidth="40" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" Visibility="{x:Bind ViewModel.IsComposite, Mode=OneWay}">
        <TextBlock Text="ポイント数" Style="{StaticResource AsSecondaryTextStyle}" FontSize="13" VerticalAlignment="Center" />
        <ComboBox Style="{StaticResource FilterButtonStyle}" MinWidth="104" ItemsSource="{x:Bind ViewModel.PointCountOptions}"
                  SelectedItem="{x:Bind ViewModel.PointCountLabel, Mode=TwoWay}"
                  ToolTipService.ToolTip="モードごとに、時間帯に収まる複合ポイントを順位の高い順に使う数" />
      </StackPanel>
    </StackPanel>

    <!-- データグリッド + その日のサマリー（フッター） -->
    <Border Grid.Row="3" Style="{StaticResource AsCardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="34" />
          <RowDefinition Height="*" />
          <RowDefinition Height="38" />
        </Grid.RowDefinitions>
        <Grid Padding="12,0" BorderBrush="{ThemeResource AsDividerBrush}" BorderThickness="0,0,0,1" helpers:GridColumns.Layout="{StaticResource GridLayout}">
          <TextBlock Text="状態" Style="{StaticResource AsGridHeaderTextStyle}" />
          <!-- 見出しを押すと、その列で並べる → 逆順 → 既定（Entry 時刻順）と切り替わる -->
          <Button Grid.Column="1" Style="{StaticResource AsGridHeaderButtonStyle}" ContentTemplate="{StaticResource SortHeaderTemplate}"
                  Content="{x:Bind ViewModel.RankHeader}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="{x:Bind ViewModel.RankHeader}"
                  ToolTipService.ToolTip="銘柄 × モードごとのポイントの順位。複合モードでは選んだ銘柄を通したモードごとの順位" />
          <Button Grid.Column="2" Style="{StaticResource AsGridHeaderButtonStyle}" ContentTemplate="{StaticResource SortHeaderTemplate}"
                  Content="{x:Bind ViewModel.PairHeader}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="{x:Bind ViewModel.PairHeader}" />
          <Button Grid.Column="3" Style="{StaticResource AsGridHeaderButtonStyle}" ContentTemplate="{StaticResource SortHeaderTemplate}"
                  Content="{x:Bind ViewModel.TimeHeader}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="{x:Bind ViewModel.TimeHeader}" />
          <Button Grid.Column="4" Style="{StaticResource AsGridHeaderButtonStyle}" ContentTemplate="{StaticResource SortHeaderTemplate}"
                  Content="{x:Bind ViewModel.DirectionHeader}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="{x:Bind ViewModel.DirectionHeader}" />
          <Button Grid.Column="5" Style="{StaticResource AsGridHeaderButtonStyle}" ContentTemplate="{StaticResource SortHeaderTemplate}"
                  Content="{x:Bind ViewModel.ModeHeader}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="{x:Bind ViewModel.ModeHeader}" />
          <Button Grid.Column="6" Style="{StaticResource AsGridHeaderButtonStyle}" HorizontalContentAlignment="Right" ContentTemplate="{StaticResource SortHeaderTemplate}"
                  Content="{x:Bind ViewModel.WinRateHeader}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="{x:Bind ViewModel.WinRateHeader}" />
          <Button Grid.Column="7" Style="{StaticResource AsGridHeaderButtonStyle}" HorizontalContentAlignment="Right" ContentTemplate="{StaticResource SortHeaderTemplate}"
                  Content="{x:Bind ViewModel.AverageHeader}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="{x:Bind ViewModel.AverageHeader}" />
          <Button Grid.Column="8" Style="{StaticResource AsGridHeaderButtonStyle}" HorizontalContentAlignment="Right" ContentTemplate="{StaticResource SortHeaderTemplate}"
                  Content="{x:Bind ViewModel.ResultHeader}" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="{x:Bind ViewModel.ResultHeader}" />
        </Grid>

        <ListView x:Name="EntryList" Grid.Row="1" Style="{StaticResource AsGridListViewStyle}" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
          <!-- 仮想化しないパネルにする。既定の ItemsStackPanel（仮想化）は、一覧を差し替えた直後に離れた行へ
               ScrollIntoView すると、Uno（Skia）でスクロール範囲の見積もりが崩れて末尾の数行だけが描かれ、レイアウトが止まらなくなる。
               行は 1 日で最大数百（32px）なので、すべて作っても重くない -->
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:EntryRowViewModel">
              <Grid Height="32">
                <Border Background="{ThemeResource AsZebraBrush}" Visibility="{x:Bind IsOdd}" />
                <Border Background="{ThemeResource AsRowSelectedBrush}" Visibility="{x:Bind IsNext, Mode=OneWay}" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{ThemeResource AsAccentBrush}" Visibility="{x:Bind IsNext, Mode=OneWay}" />
                <Grid Padding="12,0" helpers:GridColumns.Layout="{StaticResource GridLayout}">

                  <!-- 状態 -->
                  <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsDone, Mode=OneWay}">
                    <TextBlock Text="{StaticResource IconCheck}" Style="{StaticResource AsIconStyle}" FontSize="13" />
                    <TextBlock Text="完了" Style="{StaticResource AsCaptionTextStyle}" FontSize="13" />
                  </StackPanel>
                  <Border CornerRadius="4" Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Background="{ThemeResource AsAccentBrush}" Visibility="{x:Bind IsNext, Mode=OneWay}">
                    <TextBlock Text="{x:Bind NextLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource AsTextOnAccentBrush}" />
                  </Border>
                  <TextBlock Text="待機" Style="{StaticResource AsCaptionTextStyle}" FontSize="13" Visibility="{x:Bind IsWaiting, Mode=OneWay}" />

                  <TextBlock Grid.Column="1" Text="{x:Bind Rank}" Style="{StaticResource AsNumberTextStyle}" FontSize="13" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="2" Text="{x:Bind Pair}" Style="{StaticResource AsBodyStrongTextStyle}" FontSize="13" />
                  <TextBlock Grid.Column="3" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource AsTextPrimaryBrush}">
                    <Run Text="{x:Bind Date}" FontWeight="Bold" /><Run Text="{x:Bind Slot}" />
                  </TextBlock>
                  <Border Grid.Column="4" Style="{StaticResource AsLongPillStyle}" Visibility="{x:Bind IsLong}">
                    <TextBlock Text="LONG" Style="{StaticResource AsPillTextStyle}" Foreground="{ThemeResource AsPositiveBrush}" />
                  </Border>
                  <Border Grid.Column="4" Style="{StaticResource AsShortPillStyle}" Visibility="{x:Bind IsShort}">
                    <TextBlock Text="SHORT" Style="{StaticResource AsPillTextStyle}" Foreground="{ThemeResource AsNegativeBrush}" />
                  </Border>
                  <TextBlock Grid.Column="5" Text="{x:Bind Mode}" Style="{StaticResource AsBodyStrongTextStyle}" FontSize="13" />
                  <Grid Grid.Column="6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Style="{StaticResource AsProgressTrackStyle}" Value="{x:Bind WinRate}" Width="40" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Text="{x:Bind WinRateText}" Style="{StaticResource AsNumberTextStyle}" FontSize="13" Width="46" />
                  </Grid>
                  <TextBlock Grid.Column="7" Text="{x:Bind AveragePips}" Style="{StaticResource AsNumberTextStyle}" FontSize="13"
                             Foreground="{ThemeResource AsPositiveBrush}" Visibility="{x:Bind AveragePositive}" />
                  <TextBlock Grid.Column="7" Text="{x:Bind AveragePips}" Style="{StaticResource AsNumberTextStyle}" FontSize="13"
                             Foreground="{ThemeResource AsNegativeBrush}" Visibility="{x:Bind AverageNegative}" />
                  <TextBlock Grid.Column="8" Text="{x:Bind Result, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontSize="13"
                             Foreground="{ThemeResource AsPositiveBrush}" Visibility="{x:Bind ResultPositive, Mode=OneWay}" />
                  <TextBlock Grid.Column="8" Text="{x:Bind Result, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontSize="13"
                             Foreground="{ThemeResource AsNegativeBrush}" Visibility="{x:Bind ResultNegative, Mode=OneWay}" />
                  <TextBlock Grid.Column="8" Text="{x:Bind Result, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontSize="13"
                             Foreground="{ThemeResource AsTextTertiaryBrush}" Visibility="{x:Bind ResultNone, Mode=OneWay}" />
                </Grid>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Margin="24,40" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"
                   Style="{StaticResource AsSecondaryTextStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

        <!-- 画面を開いたとき・日や銘柄別／複合を切り替えたときの読み込み中（起動画面と同じ進捗バー） -->
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
          <ProgressBar Width="240" IsIndeterminate="True" MinHeight="2" Height="2" />
          <TextBlock Text="エントリーを読み込み中…" Style="{StaticResource AsSecondaryTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- その日のサマリー: 結果が確定した取引の件数・勝敗・勝率・平均・合計 -->
        <Grid Grid.Row="2" Padding="12,0" Background="{ThemeResource AsFooterBrush}" CornerRadius="0,0,8,8"
              BorderBrush="{ThemeResource AsDividerBrush}" BorderThickness="0,1,0,0" helpers:GridColumns.Layout="{StaticResource GridLayout}">
          <TextBlock Text="合計" Style="{StaticResource AsBodyStrongTextStyle}" FontSize="13" />
          <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.SumTrades, Mode=OneWay}" Style="{StaticResource AsBodyStrongTextStyle}" FontSize="13" />
          <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.SumWinLoss, Mode=OneWay}" Style="{StaticResource AsBodyStrongTextStyle}" FontSize="13" />
          <TextBlock Grid.Column="6" Text="{x:Bind ViewModel.SumWinRate, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Grid.Column="7" Text="{x:Bind ViewModel.SumAverage, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Grid.Column="8" Text="{x:Bind ViewModel.SumTotal, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13"
                     Foreground="{ThemeResource AsPositiveBrush}" Visibility="{x:Bind ViewModel.SumTotalPositive, Mode=OneWay}" />
          <TextBlock Grid.Column="8" Text="{x:Bind ViewModel.SumTotal, Mode=OneWay}" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13"
                     Foreground="{ThemeResource AsNegativeBrush}" Visibility="{x:Bind ViewModel.SumTotalNegative, Mode=OneWay}" />
          <TextBlock Grid.Column="8" Text="—" Style="{StaticResource AsNumberTextStyle}" FontWeight="SemiBold" FontSize="13"
                     Visibility="{x:Bind ViewModel.SumTotalNone, Mode=OneWay}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
