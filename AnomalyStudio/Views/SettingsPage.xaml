<Page x:Class="AnomalyStudio.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:AnomalyStudio.ViewModels"
      Background="Transparent">
  <!-- 5a/5b 設定: 一般・銘柄・データ・経済指標の表示フィルター・AIアシスト・バージョン情報 -->
  <Page.Resources>
    <Style x:Key="CardGridStyle" TargetType="Grid">
      <Setter Property="ColumnSpacing" Value="16" />
      <Setter Property="MinHeight" Value="64" />
    </Style>
    <Style x:Key="CardIconStyle" TargetType="TextBlock" BasedOn="{StaticResource AsIconStyle}">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{ThemeResource AsTextPrimaryBrush}" />
    </Style>
    <Style x:Key="ControlStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
      <Setter Property="MinWidth" Value="200" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AsBodyStrongTextStyle}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </Page.Resources>

  <ScrollViewer>
    <StackPanel Padding="{StaticResource AsSettingsPagePadding}" MaxWidth="{StaticResource AsSettingsMaxWidth}" HorizontalAlignment="Stretch">
      <TextBlock Text="設定" Style="{StaticResource AsLargeTitleTextStyle}" Margin="0,0,0,4" />

      <!-- 一般 -->
      <TextBlock Text="一般" Style="{StaticResource AsSectionHeaderTextStyle}" />
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconPalette}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="テーマ" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="アプリの配色を選択します" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <ComboBox Grid.Column="2" Style="{StaticResource ControlStyle}" ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                    SelectedItem="{x:Bind ViewModel.Settings.Theme, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconHouseLine}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="起動時の画面" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="アプリ起動時に最初に表示する画面" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <ComboBox Grid.Column="2" Style="{StaticResource ControlStyle}" ItemsSource="{x:Bind ViewModel.StartScreenOptions}"
                    SelectedItem="{x:Bind ViewModel.Settings.StartScreen, Mode=TwoWay}" />
        </Grid>
      </Border>

      <!-- 銘柄: 分析対象のペアを追加・有効化する -->
      <TextBlock Text="銘柄" Style="{StaticResource AsSectionHeaderTextStyle}" />
      <ItemsControl ItemsSource="{x:Bind ViewModel.SymbolItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SymbolItemViewModel">
            <Border Style="{StaticResource AsSettingsCardStyle}">
              <Grid Style="{StaticResource CardGridStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{StaticResource IconCube}" Style="{StaticResource CardIconStyle}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Style="{StaticResource AsBodyStrongTextStyle}">
                    <Run Text="{x:Bind Id}" /><Run Text="  " /><Run Text="{x:Bind Detail}" FontWeight="Normal" FontSize="12"
                                                                      Foreground="{ThemeResource AsTextSecondaryBrush}" />
                  </TextBlock>
                  <TextBlock Text="{x:Bind Coverage}" Style="{StaticResource AsCaptionTextStyle}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" OnContent="有効" OffContent="無効" MinWidth="0"
                              IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                <Button Grid.Column="3" Style="{StaticResource AsIconButtonStyle}" Content="{StaticResource IconX}"
                        ToolTipService.ToolTip="銘柄と取り込んだデータを削除" Command="{x:Bind RemoveCommand}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconPlus}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="銘柄を追加" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="Dukascopy で取得できる FX・貴金属から選びます（追加後に分析を実行）" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <ComboBox Grid.Column="2" MinWidth="140" VerticalAlignment="Center" PlaceholderText="選択"
                    ItemsSource="{x:Bind ViewModel.AvailableInstruments, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedInstrument, Mode=TwoWay}" />
          <Button Grid.Column="3" Content="追加" MinWidth="72" Command="{x:Bind ViewModel.AddSymbolCommand}" />
        </Grid>
      </Border>

      <!-- データ: 保存先・取込・分析の実行タイミング -->
      <TextBlock Text="データ" Style="{StaticResource AsSectionHeaderTextStyle}" />
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconFolder}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="データの保存場所" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="1分足・分析結果・経済指標を保存しているフォルダー" Style="{StaticResource AsCaptionTextStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.DataDirectory}" Style="{StaticResource AsCaptionTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          </StackPanel>
          <Button Grid.Column="2" Content="フォルダーを開く" Command="{x:Bind ViewModel.OpenDataFolderCommand}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconArrowsClockwise}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="起動時にデータを更新" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="前回からの1分足を取り込み、エントリーの結果を確定させます" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="2" OnContent="オン" OffContent="オフ" MinWidth="0"
                        IsOn="{x:Bind ViewModel.Settings.UpdateOnStartup, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconCalendarBlank}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="週次の自動分析" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="指定の曜日・時刻に取込と分析を実行します（オフのときは手動）" Style="{StaticResource AsCaptionTextStyle}" TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox Grid.Column="2" MinWidth="96" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.ScheduleDayOptions}"
                    SelectedItem="{x:Bind ViewModel.ScheduleDayLabel, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.Settings.ScheduleEnabled, Mode=OneWay}" />
          <ComboBox Grid.Column="3" MinWidth="96" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.ScheduleTimeOptions}"
                    SelectedItem="{x:Bind ViewModel.Settings.ScheduleTime, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.Settings.ScheduleEnabled, Mode=OneWay}" />
          <ToggleSwitch Grid.Column="4" OnContent="オン" OffContent="オフ" MinWidth="0"
                        IsOn="{x:Bind ViewModel.Settings.ScheduleEnabled, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconSliders}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="分析結果の保持数" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="銘柄ごとに残す分析結果の数（古いものから削除）" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <ComboBox Grid.Column="2" Style="{StaticResource ControlStyle}" ItemsSource="{x:Bind ViewModel.RunsToKeepOptions}"
                    SelectedItem="{x:Bind ViewModel.RunsToKeepLabel, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconCalendarCheck}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="経済指標の更新間隔" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="経済指標カレンダーを取得するタイミング" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <ComboBox Grid.Column="2" Style="{StaticResource ControlStyle}" ItemsSource="{x:Bind ViewModel.CalendarRefreshOptions}"
                    SelectedItem="{x:Bind ViewModel.Settings.CalendarRefresh, Mode=TwoWay}" />
        </Grid>
      </Border>

      <!-- 経済指標の表示フィルター -->
      <TextBlock Text="経済指標の表示フィルター" Style="{StaticResource AsSectionHeaderTextStyle}" />
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconFlag}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="国" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="経済指標カレンダーに表示する国・地域" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <DropDownButton Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                          Content="{x:Bind ViewModel.CountryLabel, Mode=OneWay}">
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="220" Spacing="2">
                  <Button Content="すべて選択 / 解除" Style="{StaticResource AsSubtleButtonStyle}" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.SelectAllCountriesCommand}" />
                  <Rectangle Height="1" Fill="{ThemeResource AsDividerBrush}" Margin="0,2" />
                  <!-- 国が多いので一覧はスクロールさせる -->
                  <ScrollViewer MaxHeight="360">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Countries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CountryOptionViewModel">
                          <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinHeight="32">
                            <TextBlock><Run Text="{x:Bind Code}" FontWeight="SemiBold" />  <Run Text="{x:Bind Name}" Foreground="{ThemeResource AsTextSecondaryBrush}" /></TextBlock>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </Grid>
      </Border>
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconStar}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="重要度" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="指定した重要度以上の指標のみ表示します" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <ComboBox Grid.Column="2" Style="{StaticResource ControlStyle}" ItemsSource="{x:Bind ViewModel.CalendarStarOptions}"
                    SelectedItem="{x:Bind ViewModel.CalendarStars, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{x:Bind}" Foreground="{ThemeResource AsAccentBrush}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>

      <!-- AIアシスト -->
      <TextBlock Text="AIアシスト" Style="{StaticResource AsSectionHeaderTextStyle}" />
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconLink}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="ベースURL" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="OpenAI 互換 API のエンドポイント" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <TextBox Grid.Column="2" Width="260" VerticalAlignment="Center" Text="{x:Bind ViewModel.Settings.AiBaseUrl, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconKey}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="APIキー" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.KeyStorageNote}"
                       Style="{StaticResource AsCaptionTextStyle}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <PasswordBox Width="260" PlaceholderText="sk-…" Password="{x:Bind ViewModel.ApiKey, Mode=TwoWay}" />
            <Button Content="削除" Command="{x:Bind ViewModel.DeleteStoredKeyCommand}"
                    Visibility="{x:Bind ViewModel.HasStoredKey, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.KeyDeleteTip}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconCube}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="モデル" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="SQL生成に使用するモデル名" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <TextBox Grid.Column="2" Width="260" VerticalAlignment="Center" Text="{x:Bind ViewModel.Settings.AiModel, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconPlugs}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="接続テスト" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="入力した設定でAPIに接続できるか確認します。合格するまでAIアシストは使えません"
                       Style="{StaticResource AsCaptionTextStyle}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{StaticResource IconCheck}" Style="{StaticResource AsIconStyle}" Foreground="{ThemeResource AsPositiveBrush}"
                       Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
          <Button Grid.Column="3" Content="テスト" MinWidth="80" Command="{x:Bind ViewModel.TestConnectionCommand}" />
        </Grid>
      </Border>

      <!-- バージョン情報 -->
      <TextBlock Text="バージョン情報" Style="{StaticResource AsSectionHeaderTextStyle}" />
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28">
            <Image Source="ms-appx:///Assets/Images/anomalystudio-logo.png" Stretch="Uniform" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="AnomalyStudio" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Version}" Style="{StaticResource AsCaptionTextStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <!-- 更新: 確認してダウンロードし、「再起動して更新」で反映する（次の起動でも反映される） -->
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconArrowsClockwise}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Padding="0,10">
            <TextBlock Text="アプリの更新" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Updates.StatusText, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.RestartMessage, Mode=OneWay}" Style="{StaticResource AsCaptionTextStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource AsNegativeBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="更新を確認" Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                    IsEnabled="{x:Bind ViewModel.Updates.CanCheck, Mode=OneWay}" />
            <Button Content="再起動して更新" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RestartToUpdateCommand}"
                    Visibility="{x:Bind ViewModel.Updates.IsReadyToRestart, Mode=OneWay}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource AsSettingsCardStyle}">
        <Grid Style="{StaticResource CardGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource IconArrowsClockwise}" Style="{StaticResource CardIconStyle}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="起動時に更新を確認" Style="{StaticResource AsBodyStrongTextStyle}" />
            <TextBlock Text="新しい版があればダウンロードしておき、再起動か次の起動で更新します" Style="{StaticResource AsCaptionTextStyle}" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="2" OnContent="オン" OffContent="オフ" MinWidth="0"
                        IsOn="{x:Bind ViewModel.Settings.CheckForUpdatesOnStartup, Mode=TwoWay}" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
